---
import BaseHead from '../components/BaseHead.astro'
import Body from '../components/Body.astro'
import Header from '../components/Header.astro'
import Masthead from '../components/Masthead.astro'
import Content from '../components/Content.astro'
import Footer from '../components/Footer.astro'
import SectionCard from '../components/SectionCard.astro'

--- 
const sections = [
  {
    title: "Research Fields",
    description: "Explore the main research areas and projects our team is focusing on.",
    image: "/images/research-fields.jpg",
    button: "Learn More",
    link: "/research-fields"
  },
  {
    title: "Research Assistant",
    description: "Meet our research assistants and see how they contribute to projects.",
    image: "/images/research-assistant.jpg",
    button: "View Assistants",
    link: "/research-assistants"
  },
  {
    title: "Research Activities",
    description: "Check out seminars, workshops, and collaborative research activities.",
    image: "/images/research-activities.jpg",
    button: "See Activities",
    link: "/research-activities"
  },
  {
    title: "Lifestyle",
    description: "Discover the lifestyle and culture of our research community.",
    image: "/images/lifestyle.jpg",
    button: "Explore Lifestyle",
    link: "/lifestyle"
  }
]

<html lang="en">
  <head>
    <BaseHead title="Research Overview / SITE_TITLE" description="Overview of our research and activities." />
  </head>
  <Body>
    <Header title="SITE_TITLE" />
    <main class="pt-[56px]">
      <Masthead />
      <Content>
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 my-12">
          {sections.map(section => (
            <SectionCard 
              title={section.title} 
              description={section.description} 
              image={section.image} 
              button={section.button} 
              link={section.link} 
            />
          ))}
        </section>
      </Content>
    </main>
    <Footer />
  </Body>
</html>
